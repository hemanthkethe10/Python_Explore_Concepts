# Environment Configuration for Explore Server

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
RELOAD=True

# Rate Limiting Configuration
DEFAULT_RATE_LIMIT=10/minute
STRICT_RATE_LIMIT=5/minute
LOOSE_RATE_LIMIT=50/minute
GRAPHQL_RATE_LIMIT=15/minute

# Rate Limit Response Configuration
RETRY_AFTER_SECONDS=60
RATE_LIMIT_MESSAGE=Rate limit exceeded

# CORS Configuration
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=True

# Logging Configuration
LOG_LEVEL=info

# API Configuration
API_TITLE=Explore Server
API_VERSION=1.0.0
API_DESCRIPTION=FastAPI server with rate limiting, REST API, and GraphQL endpoints

# GraphQL Configuration
GRAPHQL_PLAYGROUND_ENABLED=True
GRAPHQL_INTROSPECTION_ENABLED=True

# Slow Operation Configuration
MAX_SLOW_OPERATION_DELAY=10